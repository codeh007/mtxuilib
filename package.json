{
  "name": "mtxuilib",
  "version": "0.8.35",
  "description": "Standalone public UI component library extracted from gomtm.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeh007/mtxuilib.git"
  },
  "homepage": "https://github.com/codeh007/mtxuilib#readme",
  "bugs": {
    "url": "https://github.com/codeh007/mtxuilib/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/*": "./dist/styles/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "next": "^15",
    "react": "^19.2",
    "react-dom": "^19.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-styles",
    "copy-styles": "mkdir -p dist/styles && cp -r src/styles/* dist/styles/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "tsc -p tsconfig.smoke.json --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@paralleldrive/cuid2": "^2.2.2",
